  <!-- ==================== जावास्क्रिप्ट लॉजिक ==================== -->
  <script>
    // आपकी Google Sheet ID (लिंक से ली गई)
    const GOOGLE_SHEET_ID = '1gWtnX3JFPxNuIsEMuwxR9xWLRUjDWWHN88mBL7xaUTE';

    let rawData = {
      avshesh: [
        { desc: 'होली 2024', amount: 4228 },
        { desc: 'दशहरा 2024', amount: 1000 },
        { desc: 'होली 2025', amount: 537 }
      ],
      chanda: [],
      kharch: [],
      sahayog: []
    };

    // 20 अक्टूबर 2026, 20:00:00 IST काउंटडाउन
    const targetDate = new Date('2026-10-20T20:00:00+05:30').getTime();

    function updateCountdown() {
      const now = new Date().getTime();
      const diff = targetDate - now;

      if (diff <= 0) {
        document.getElementById('countdown-timer').innerHTML = 
          '<div class="col-span-4 text-xl font-bold text-amber-300">जय माता दी! कार्यक्रम प्रारंभ हो चुका है!</div>';
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      document.getElementById('cd-days').textContent = String(days).padStart(2, '0');
      document.getElementById('cd-hours').textContent = String(hours).padStart(2, '0');
      document.getElementById('cd-minutes').textContent = String(minutes).padStart(2, '0');
      document.getElementById('cd-seconds').textContent = String(seconds).padStart(2, '0');
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();

    function switchTab(tabName) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('border-orange-600', 'text-orange-600');
        btn.classList.add('border-transparent', 'text-gray-500');
      });

      document.getElementById('tab-' + tabName).classList.remove('hidden');
      const activeBtn = document.getElementById('tab-btn-' + tabName);
      activeBtn.classList.add('border-orange-600', 'text-orange-600');
      activeBtn.classList.remove('border-transparent', 'text-gray-500');
    }

    // Google Sheets Visualization API से डेटा लोड करना
    async function fetchSheetTab(tabName) {
      const url = https://docs.google.com/spreadsheets/d/${GOOGLE_SHEET_ID}/gviz/tq?tqx=out:json&sheet=${encodeURIComponent(tabName)};
      try {
        const res = await fetch(url);
        const text = await res.text();
        const jsonStr = text.substring(text.indexOf('{'), text.lastIndexOf('}') + 1);
        const json = JSON.parse(jsonStr);
        return json.table.rows.map(r => r.c.map(cell => (cell ? cell.v : '')));
      } catch (err) {
        console.warn(Tab '${tabName}' लोड करने में त्रुटि:, err);
        return null;
      }
    }

    async function loadAllData() {
      const [avRows, chRows, khRows, saRows] = await Promise.all([
        fetchSheetTab('पिछला_अवशेष'),
        fetchSheetTab('चंदा_संग्रह'),
        fetchSheetTab('खर्च_विवरण'),
        fetchSheetTab('वस्तु_सेवा_सहयोग')
      ]);

      // चंदा संग्रह पार्स करें
      if (chRows && chRows.length > 1) {
        rawData.chanda = chRows.slice(1).map(r => ({
          year: String(r[0] || '').trim(),
          sr: r[1],
          name: r[2],
          amount: Number(r[3]) || 0,
          remark: r[4] || '-'
        })).filter(x => x.name);
      }

      // खर्च विवरण पार्स करें
      if (khRows && khRows.length > 1) {
        rawData.kharch = khRows.slice(1).map(r => ({
          year: String(r[0] || '').trim(),
          sr: r[1],
          item: r[2],
          amount: Number(r[3]) || 0,
          category: r[4] || 'सामान्य'
        })).filter(x => x.item);
      }

      // वस्तु/सेवा पार्स करें
      if (saRows && saRows.length > 1) {
        rawData.sahayog = saRows.slice(1).map(r => ({
          year: String(r[0] || '').trim(),
          sr: r[1],
          name: r[2],
          type: r[3],
          detail: r[4] || '-'
        })).filter(x => x.name);
      }

      // अवशेष पार्स करें (यदि शीट में मौजूद हो)
      if (avRows && avRows.length > 1) {
        const parsedAv = avRows.slice(1).map(r => ({
          desc: r[0] || r[1] || 'पुराना अवशेष',
          amount: Number(r[1] || r[2] || 0)
        })).filter(x => x.amount > 0);
        if (parsedAv.length > 0) rawData.avshesh = parsedAv;
      }

      // उपलब्ध वर्षों को ड्रॉपडाउन में जोड़ना
      populateYearDropdown();
      renderApp();
    }

    function populateYearDropdown() {
      const yearsSet = new Set();
      rawData.chanda.forEach(x => { if (x.year) yearsSet.add(x.year); });
      rawData.kharch.forEach(x => { if (x.year) yearsSet.add(x.year); });
      rawData.sahayog.forEach(x => { if (x.year) yearsSet.add(x.year); });

      // यदि शीट अभी खाली है तो 2026 और 2025 डिफ़ॉल्ट रखें
      if (yearsSet.size === 0) {
        yearsSet.add('2026');
        yearsSet.add('2025');
      }

      const sortedYears = Array.from(yearsSet).sort().reverse();
      const select = document.getElementById('year-select');
      select.innerHTML = '<option value="all">समस्त सत्र (All Records)</option>';
      
      sortedYears.forEach(yr => {
        const opt = document.createElement('option');
        opt.value = yr;
        opt.textContent = सत्र ${yr};
        if (yr === '2026') opt.selected = true; // 2026 को प्राथमिकता
        select.appendChild(opt);
      });
    }

    function renderApp() {
      const selectedYear = document.getElementById('year-select').value;

      const filteredChanda = selectedYear === 'all' 
        ? rawData.chanda 
        : rawData.chanda.filter(x => x.year === selectedYear);

      const filteredKharch = selectedYear === 'all' 
        ? rawData.kharch 
        : rawData.kharch.filter(x => x.year === selectedYear);

      const filteredSahayog = selectedYear === 'all' 
        ? rawData.sahayog 
        : rawData.sahayog.filter(x => x.year === selectedYear);

      const totalIncome = filteredChanda.reduce((acc, cur) => acc + cur.amount, 0);
      const totalExpense = filteredKharch.reduce((acc, cur) => acc + cur.amount, 0);
      
      // कुल अवशेष
      const openingBalance = rawData.avshesh.reduce((acc, cur) => acc + cur.amount, 0);
      const netBalance = (openingBalance + totalIncome) - totalExpense;

      // कार्ड्स अपडेट
      document.getElementById('stat-opening').textContent = '₹' + openingBalance.toLocaleString('en-IN');
      document.getElementById('stat-income').textContent = '₹' + totalIncome.toLocaleString('en-IN');
      document.getElementById('stat-income-count').textContent = ${filteredChanda.length} दानदाता;

      document.getElementById('stat-expense').textContent = '₹' + totalExpense.toLocaleString('en-IN');
      document.getElementById('stat-expense-count').textContent = ${filteredKharch.length} मदों में व्यय;

      document.getElementById('stat-balance').textContent = '₹' + netBalance.toLocaleString('en-IN');

      renderChandaTable(filteredChanda);
      renderKharchTable(filteredKharch);
      renderSahayogTable(filteredSahayog);
      renderAvsheshTable();
    }

    function renderChandaTable(list) {
      const tbody = document.getElementById('chanda-table-body');
      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-6 text-gray-400">इस सत्र के लिए कोई चंदा रिकॉर्ड नहीं मिला।</td></tr>';
        return;
      }

      tbody.innerHTML = list.map((item, idx) => `
        <tr class="hover:bg-amber-50/50 transition">
          <td class="py-3 px-4 font-semibold text-gray-500">${item.sr || (idx + 1)}</td>
          <td class="py-3 px-4"><span class="bg-orange-100 text-orange-800 text-xs px-2 py-0.5 rounded font-bold">${item.year}</span></td>
          <td class="py-3 px-4 font-bold text-gray-900">${item.name}</td>
          <td class="py-3 px-4 text-right font-black text-emerald-700">₹${Number(item.amount).toLocaleString('en-IN')}</td>
          <td class="py-3 px-4 text-gray-600">${item.remark || '-'}</td>
        </tr>
      `).join('');
    }

    function filterChanda() {
      const query = document.getElementById('chanda-search').value.toLowerCase().trim();
      const selectedYear = document.getElementById('year-select').value;
      
      let baseList = selectedYear === 'all' 
        ? rawData.chanda 
        : rawData.chanda.filter(x => x.year === selectedYear);

      if (query) {
        baseList = baseList.filter(x => x.name.toLowerCase().includes(query));
      }

      renderChandaTable(baseList);
    }

    function renderKharchTable(list) {
      const tbody = document.getElementById('kharch-table-body');
      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-6 text-gray-400">इस सत्र के लिए कोई खर्च दर्ज नहीं है।</td></tr>';
        return;
      }

      tbody.innerHTML = list.map((item, idx) => `
        <tr class="hover:bg-rose-50/50 transition">
          <td class="py-3 px-4 font-semibold text-gray-500">${item.sr || (idx + 1)}</td>
          <td class="py-3 px-4"><span class="bg-rose-100 text-rose-800 text-xs px-2 py-0.5 rounded font-bold">${item.year}</span></td>
          <td class="py-3 px-4 font-bold text-gray-900">${item.item}</td>
          <td class="py-3 px-4"><span class="bg-gray-100 text-gray-700 text-xs px-2 py-1 rounded">${item.category}</span></td>
          <td class="py-3 px-4 text-right font-black text-rose-700">₹${Number(item.amount).toLocaleString('en-IN')}</td>
        </tr>
      `).join('');
    }

    function renderSahayogTable(list) {
      const tbody = document.getElementById('sahayog-table-body');
      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-6 text-gray-400">इस सत्र के लिए कोई सहयोग दर्ज नहीं है।</td></tr>';
        return;
      }

      tbody.innerHTML = list.map((item, idx) => `
        <tr class="hover:bg-amber-50/50 transition">
          <td class="py-3 px-4 font-semibold text-gray-500">${item.sr || (idx + 1)}</td>
          <td class="py-3 px-4"><span class="bg-amber-100 text-amber-800 text-xs px-2 py-0.5 rounded font-bold">${item.year}</span></td>
          <td class="py-3 px-4 font-bold text-gray-900">${item.name}</td>
          <td class="py-3 px-4 font-semibold text-orange-700">${item.type}</td>
          <td class="py-3 px-4 text-gray-600">${item.detail}</td>
        </tr>
      `).join('');
    }

    function renderAvsheshTable() {
      const tbody = document.getElementById('avshesh-table-body');
      let total = 0;
      tbody.innerHTML = rawData.avshesh.map(item => {
        total += item.amount;
        return `
          <tr class="hover:bg-blue-50/50 transition">
            <td class="py-3 px-4 font-bold text-gray-800">${item.desc}</td>
            <td class="py-3 px-4 text-right font-black text-blue-700">₹${item.amount.toLocaleString('en-IN')}</td>
          </tr>
        `;
      }).join('') + `
        <tr class="bg-blue-100/70 font-bold border-t-2 border-blue-300">
          <td class="py-3 px-4 text-blue-950">कुल पुराना अवशेष (Grand Total)</td>
          <td class="py-3 px-4 text-right text-blue-950 font-black text-base">₹${total.toLocaleString('en-IN')}</td>
        </tr>
      `;
    }

    loadAllData();
  </script>
</body>
</html>
